# Committed defaults (no secrets). Copy values to .env.local for local overrides.
# .env.local is gitignored and should contain secrets like OPENROUTER_API_KEY.

DATABASE_URL=postgres://devuser:devpassword@db:5432/boggle?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://host.docker.internal:5173
PORT=8080

# Misclue Solo Mode AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
